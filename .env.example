# Optional. The app works fully without this key — see docs/LLM_ARCHITECTURE.md.
# When unset, natural-language questions are answered with template-based
# responses computed directly from the database (no LLM call happens).
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini if OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini

# Path to the SQLite database file. Defaults to data/app.db if unset.
DATABASE_PATH=data/app.db
